[Unit]
Description=Sectorbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/rust-projects/sectorbot
ExecStart=%h/workspace/rust-projects/sectorbot/target/debug/sectorbot
Restart=on-failure
RestartSec=5
Environment=WORKDIR=%h/rust-projects/sectorbot

[Install]
WantedBy=default.target
