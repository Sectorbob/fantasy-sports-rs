# Example user unit: copy to ~/.config/systemd/user/sectorbot.service and adjust the paths
# (%h is your home directory), then `systemctl --user enable --now sectorbot`.
# Configuration is read from a .env file in WorkingDirectory, see .env.example.
[Unit]
Description=Sectorbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/fantasy-sports-rs/apps/sectorbot
ExecStart=%h/fantasy-sports-rs/target/release/sectorbot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
