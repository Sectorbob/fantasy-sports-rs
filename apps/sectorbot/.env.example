# Copy to .env (local dev) or pass at runtime: docker run --env-file .env ...
RUST_LOG=info
HIDE_LOG_TS=false
HTTP_SERVER_PORT=8080
HTTP_BIND_ADDRESS=127.0.0.1   # 0.0.0.0 to listen on every interface (the API has no authentication)

DISCORD_TOKEN=
TWITTER_COOKIE=
YT_API_KEY=

# Optional
SLEEPER_LEAGUE_ID=            # league used by !keepables and !draftorder (commands disabled when unset)
ADMIN_DISCORD_USER_ID=        # the only user allowed to run ! commands (all refused when unset)
FEEDS_FILE=feeds.json         # feeds to seed at startup, see feeds.example.json
ENABLE_FEED_FETCHER=false     # true: poll every feed and post new entries to its discord channel
PUBLIC_BASE_URL=              # base url for links in RSS feeds (default http://localhost:<HTTP_SERVER_PORT>)

# Yahoo OAuth (public client, PKCE, no secret)
YAHOO_CLIENT_ID=
YAHOO_REDIRECT_URI=
