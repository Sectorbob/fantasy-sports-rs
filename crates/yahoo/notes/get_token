#!/bin/bash

source .env # Loads YAHOO_CLIENT_ID

# usage: ./get_token <code from the redirect> <code_verifier used for request_auth>
code=$1
code_verifier=$2

curl -v -X POST \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "client_id=${YAHOO_CLIENT_ID}&redirect_uri=oob&code=${code}&grant_type=authorization_code&code_verifier=${code_verifier}" \
  "https://api.login.yahoo.com/oauth2/get_token"

